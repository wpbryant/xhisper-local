# xhisper configuration
# Copy to ~/.config/xhisper/xhisperrc and customize
# When in doubt, check by running 'xhisper --log'

# Transcription Engine:
# - parakeet : NVIDIA Parakeet TDT 0.6B via onnx-asr — more accurate than
#   whisper-base in English and already outputs punctuation + capitalization,
#   so standard dictation skips the LLM formatting pass entirely.
#   Requires: pip3 install --break-system-packages onnx-asr
#   First use downloads ~1GB to ~/.cache/xhisper/parakeet (one time).
# - whisper : the original faster-whisper engine
transcription-engine : parakeet

# Parakeet model (parakeet engine only):
# - nemo-parakeet-tdt-0.6b-v2 : English only (best English accuracy)
# - nemo-parakeet-tdt-0.6b-v3 : multilingual (25 languages, auto-detects)
parakeet-model : nemo-parakeet-tdt-0.6b-v2

# Whisper Model Settings (whisper engine only):
# Available models: tiny, base, small, medium, large-v3
# - tiny: fastest, least accurate (~1GB RAM)
# - base: fast, decent accuracy (~1GB RAM) [recommended]
# - small: slower, better accuracy (~2GB RAM)
# - medium: much slower, very good accuracy (~5GB RAM)
# - large-v3: slowest, best accuracy (~10GB RAM)
model-name : base

# Device (both engines): auto, cpu, or cuda
# - whisper: auto detects and uses CUDA if available
# - parakeet: auto and cpu run on CPU (default — already fast); cuda runs
#   on the GPU via onnxruntime-gpu, worth it for long (VAD-segmented)
#   dictations (~2.3x faster on an 80s clip; short ones gain little since
#   per-run model load dominates):
#     pip3 install --break-system-packages 'onnxruntime-gpu==1.24.4' nvidia-curand-cu12 nvidia-cufft-cu12
#   (onnxruntime-gpu replaces onnxruntime; wheels >= 1.26 are built for
#   CUDA 13 and do not load against the CUDA 12 libraries most stacks ship)
model-device : auto

# Language: leave empty for auto-detect, or specify code (e.g., en, es, fr)
# Specifying language makes transcription faster and more accurate
model-language : ""

# Transcription Settings:
transcription-prompt     : ""

# ASR mishear corrections (both engines): comma-separated from=to phrases,
# case-insensitive whole-phrase matches, longest source first. The ASR
# cannot be vocabulary-biased, so homophones it mishears get fixed here —
# e.g. parakeet hears "Claude" as "clawed":
#   transcription-corrections : clawed code=Claude Code,clawed=Claude
# NB: matches replace literal uses too ("the cat clawed" -> "the cat Claude"),
# so only map words you never dictate with their literal meaning.
transcription-corrections : ""

# VAD: silence (ms) before the whisper VAD splits segments. Raise this if
# speech after a thinking pause still gets dropped (whisper engine only).
vad-min-silence-ms : 5000

# Paste Timing (seconds):
non-ascii-initial-delay : 0.15 # Increase this if first character comes out wrong.
non-ascii-default-delay : 0.025

# Silence Detection:
silence-threshold  : -50
silence-percentage : 95

# AI Post-Processing (optional):
# Improve grammar, punctuation, and capitalization using local models via
# Ollama — a fast dedicated cleanup model for standard text, and/or an
# instruct LLM for command/email modes
# - cleanup-model : Ollama model for dictation cleanup of standard text
#   (filler words, spoken corrections, numbers, email/web addresses).
#   Recommended: Spokenly cleanup-1, a 0.6B model built exactly for this
#   (~639MB, ~0.1-0.3s per dictation, Apache-2.0):
#     ollama pull hf.co/spokenly/cleanup-1-gguf:Q8_0
#   then set:  cleanup-model : xhisper-cleanup-1
#   The tuned alias (correct prompt format + greedy decoding) is created
#   automatically on first use. When set, standard text always goes through
#   it — even on parakeet, since removing "um"/"uh" and spoken corrections
#   is worth 0.1s (post-process-standard : off disables it again).
#   post-process-model then only serves command/email modes.
# - post-process-model : Ollama instruct model (e.g., gemma3:4b, phi3,
#   llama3.2:3b) for command/email formatting.
#   Leave empty to disable
# - post-process-timeout : Maximum seconds to wait for LLM response
# - post-process-mode : auto, standard, command, email
#   auto: detects context based on content (default)
#   standard: normal grammar/punctuation fixes
#   command: preserves command syntax, fixes command names
#   email: formats as email with salutations and sign-offs
# - post-process-standard : AI pass for standard (non-command/email) text
#   auto: with cleanup-model set, run the cleanup model (cheap); otherwise
#   skip the instruct LLM when parakeet already punctuates — fastest (default)
#   on: always run the AI pass, e.g. instruct-LLM cleanup on top of parakeet
#   when no cleanup-model is set (adds ~1s+ per dictation)
#   off: never run it for standard text (command/email unaffected)
cleanup-model          : ""
post-process-model     : ""
post-process-timeout   : 10
post-process-mode      : auto
post-process-standard  : auto
